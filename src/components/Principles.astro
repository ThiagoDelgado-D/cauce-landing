---
import { principles } from '../content/copy';
---

<section id="principles" class="principles" aria-labelledby="principles-heading">
  <div class="principles-inner">
    <header class="principles-header">
      <div class="principles-title">
        <p class="eyebrow">{principles.eyebrow}</p>
        <h2 id="principles-heading">{principles.heading}</h2>
      </div>
      <p class="aside">{principles.aside}</p>
    </header>
  </div>
</section>

<style>
  .principles {
    background: var(--surface-inset);
    border-block: 1px solid var(--line);
  }

  .principles-inner {
    max-width: var(--content-max);
    margin: 0 auto;
    padding: clamp(80px, 12vw, 120px) var(--gutter);
  }

  .principles-header {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 16px 48px;
    margin-bottom: 40px;
  }

  .principles-title {
    display: grid;
    gap: 10px;
  }

  .eyebrow {
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  h2 {
    max-width: 20ch;
    font-size: clamp(1.875rem, 3.4vw, 2.5rem);
    text-wrap: balance;
  }

  .aside {
    max-width: 34ch;
    color: var(--ink-dim);
    font-size: 0.9375rem;
  }
</style>
